# Leave empty to run in offline scripted mode (no Sarvam calls)
SARVAM_API_KEY=

# Neon Postgres connection string (Neon console -> Connect). Leave empty to use local SQLite (data/local.db).
# If set but unreachable at startup, the app falls back to SQLite and logs why in logs/errors.log.
DATABASE_URL=

# Optional overrides (defaults shown)
# LLM_MODEL=sarvam-105b
# REASONING_EFFORT=off          # off is 3-6x faster; low/medium/high show reasoning in the trace
# TTS_SPEAKER=simran_enhi_customer
# DETAILED_LOG=true             # step-by-step timing log; also toggled live from the dashboard
# PER_TXN_CREDIT_CAP=10000
# DAILY_CREDIT_CAP=20000
